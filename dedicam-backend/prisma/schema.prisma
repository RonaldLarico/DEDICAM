// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id               Int                   @id @default(autoincrement())
  email            String                @unique
  username         String?               @unique
  password         String?
  firstName        String?
  lastName         String?
  avatarUrl        String?
  role             UserRole              @default(USER)
  isVerified       Boolean               @default(false)
  stripeCustomerId String?
  settings         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  projects         Project[]
  ownedAssets      Asset[]
  subscriptions    Subscription[]
  payments         Payment[]
  notifications    Notification[]
  collaborations   ProjectCollaborator[]
  auditLogs        AuditLog[]
}

//////////////////////////////////////////////////////
// PROJECT
//////////////////////////////////////////////////////

model Project {
  id                  Int                   @id @default(autoincrement())
  title               String
  slug                String                @unique
  description         String?
  visibility          ProjectVisibility     @default(PRIVATE)
  status              ProjectStatus         @default(DRAFT)
  isPremium           Boolean               @default(false)
  allowComments       Boolean               @default(true)
  allowDownload       Boolean               @default(false)
  settings            Json?
  currentSceneId      String?
  publishedVersionId  String?
  analyticsId         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  ownerId             Int
  owner               User                  @relation(fields: [ownerId], references: [id])
  templateId          Int?
  template            Template?             @relation(fields: [templateId], references: [id])
  thumbnailAssetId    Int?
  thumbnailAsset      Asset?                @relation("ProjectThumbnail", fields: [thumbnailAssetId], references: [id])
  scene               Scene?
  assets              ProjectAsset[]
  collaborators       ProjectCollaborator[]
  analytics           ExperienceAnalytics?
  publishedExperience PublishedExperience?
}

//////////////////////////////////////////////////////
// SCENE
//////////////////////////////////////////////////////

model Scene {
  id            Int            @id @default(autoincrement())
  activeVersion Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projectId     Int            @unique
  project       Project        @relation(fields: [projectId], references: [id])
  versions      SceneVersion[]
  drafts        SceneDraft[]
  history       SceneHistory[]
}

//////////////////////////////////////////////////////
// SCENE VERSION
//////////////////////////////////////////////////////

model SceneVersion {
  id          Int      @id @default(autoincrement())
  version     Int
  config      Json
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  sceneId     Int
  scene       Scene    @relation(fields: [sceneId], references: [id])

  @@unique([sceneId, version])
}

//////////////////////////////////////////////////////
// SCENE DRAFT
//////////////////////////////////////////////////////

model SceneDraft {
  id        Int      @id @default(autoincrement())
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sceneId   Int
  scene     Scene    @relation(fields: [sceneId], references: [id])
}

//////////////////////////////////////////////////////
// SCENE HISTORY
//////////////////////////////////////////////////////

model SceneHistory {
  id        Int      @id @default(autoincrement())
  action    String
  snapshot  Json
  createdAt DateTime @default(now())
  sceneId   Int
  scene     Scene    @relation(fields: [sceneId], references: [id])
}

//////////////////////////////////////////////////////
// TEMPLATE
//////////////////////////////////////////////////////

model Template {
  id              Int                     @id @default(autoincrement())
  name            String
  slug            String                  @unique
  description     String?
  thumbnailUrl    String?
  previewVideoUrl String?
  isPremium       Boolean                 @default(false)
  baseSceneConfig Json
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  categoryId      Int?
  category        TemplateCategory?       @relation(fields: [categoryId], references: [id])
  projects        Project[]
  assets          TemplateAsset[]
  tags            TemplateTagOnTemplate[]
}

//////////////////////////////////////////////////////
// TEMPLATE CATEGORY
//////////////////////////////////////////////////////

model TemplateCategory {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  templates Template[]
}

//////////////////////////////////////////////////////
// TEMPLATE TAG
//////////////////////////////////////////////////////

model TemplateTag {
  id        Int                     @id @default(autoincrement())
  name      String                  @unique
  templates TemplateTagOnTemplate[]
}

model TemplateTagOnTemplate {
  templateId Int
  template   Template    @relation(fields: [templateId], references: [id])
  tagId      Int
  tag        TemplateTag @relation(fields: [tagId], references: [id])

  @@id([templateId, tagId])
}

//////////////////////////////////////////////////////
// ASSET
//////////////////////////////////////////////////////

model Asset {
  id                Int             @id @default(autoincrement())
  type              AssetType
  url               String
  provider          String?
  publicId          String?
  fileName          String?
  mimeType          String?
  size              Int?
  metadata          Json?
  createdAt         DateTime        @default(now())
  ownerId           Int?
  owner             User?           @relation(fields: [ownerId], references: [id])
  projects          ProjectAsset[]
  templateAssets    TemplateAsset[]
  thumbnailProjects Project[]       @relation("ProjectThumbnail")
}

//////////////////////////////////////////////////////
// PROJECT ASSET
//////////////////////////////////////////////////////

model ProjectAsset {
  createdAt DateTime @default(now())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id])

  @@id([projectId, assetId])
}

//////////////////////////////////////////////////////
// TEMPLATE ASSET
//////////////////////////////////////////////////////

model TemplateAsset {
  createdAt  DateTime @default(now())
  templateId Int
  template   Template @relation(fields: [templateId], references: [id])
  assetId    Int
  asset      Asset    @relation(fields: [assetId], references: [id])

  @@id([templateId, assetId])
}

//////////////////////////////////////////////////////
// PUBLISHED EXPERIENCE
//////////////////////////////////////////////////////

model PublishedExperience {
  id                 Int      @id @default(autoincrement())
  publishedVersionId String
  publicUrl          String   @unique
  customDomain       String?
  seo                Json?
  settings           Json?
  createdAt          DateTime @default(now())
  projectId          Int      @unique
  project            Project  @relation(fields: [projectId], references: [id])
}

//////////////////////////////////////////////////////
// ANALYTICS
//////////////////////////////////////////////////////

model ExperienceAnalytics {
  id                  Int      @id @default(autoincrement())
  views               Int      @default(0)
  uniqueViews         Int      @default(0)
  averageViewDuration Float    @default(0)
  reactions           Json?
  countries           Json?
  devices             Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  projectId           Int      @unique
  project             Project  @relation(fields: [projectId], references: [id])
}

//////////////////////////////////////////////////////
// PAYMENTS
//////////////////////////////////////////////////////

model Payment {
  id                    Int           @id @default(autoincrement())
  stripePaymentIntentId String?
  amount                Float
  currency              String
  status                PaymentStatus
  metadata              Json?
  createdAt             DateTime      @default(now())
  userId                Int
  user                  User          @relation(fields: [userId], references: [id])
}

//////////////////////////////////////////////////////
// SUBSCRIPTIONS
//////////////////////////////////////////////////////

model Subscription {
  id                   Int                @id @default(autoincrement())
  stripeSubscriptionId String
  stripeCustomerId     String
  status               SubscriptionStatus
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  metadata             Json?
  createdAt            DateTime           @default(now())
  userId               Int
  user                 User               @relation(fields: [userId], references: [id])
}

//////////////////////////////////////////////////////
// COLLABORATORS
//////////////////////////////////////////////////////

model ProjectCollaborator {
  id        Int              @id @default(autoincrement())
  role      CollaboratorRole @default(EDITOR)
  createdAt DateTime         @default(now())
  userId    Int
  user      User             @relation(fields: [userId], references: [id])
  projectId Int
  project   Project          @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

//////////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////////

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    Int
  user      User             @relation(fields: [userId], references: [id])
}

//////////////////////////////////////////////////////
// AUDIT LOGS
//////////////////////////////////////////////////////

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  String?
  method    String?
  route     String?
  ipAddress String?
  userAgent String?
  oldValues Json?
  newValues Json?
  createdAt DateTime @default(now())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

//////////////////////////////////////////////////////
// LOGS
//////////////////////////////////////////////////////

model Logs {
  id               Int      @id @default(autoincrement())
  errorDescription String?
  message          String?
  errorContent     String?
  createdAt        DateTime @default(now())
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ProjectVisibility {
  PRIVATE
  PUBLIC
  UNLISTED
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssetType {
  IMAGE
  AUDIO
  VIDEO
  MODEL_3D
  HDR
  FONT
  TEXTURE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum CollaboratorRole {
  VIEWER
  EDITOR
  OWNER
}
